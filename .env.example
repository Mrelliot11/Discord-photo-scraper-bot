# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same Developer Portal page
DISCORD_CLIENT_ID=

# Optional: guild (server) ID to register slash commands to instantly for
# development. Leave blank to register commands globally (takes up to 1 hour
# to propagate).
DISCORD_GUILD_ID=

# Maximum number of messages to scan per channel when building the user list
# (safety cap to avoid runaway scans on huge channels).
MAX_MESSAGES_TO_SCAN=10000

# Maximum zip size (in bytes) the bot will attempt to upload back to Discord.
# Files larger than this are still saved locally but not attached to the reply.
MAX_DISCORD_UPLOAD_BYTES=8388608

# Maximum size (in bytes) of any single downloaded attachment. Anything
# larger is skipped rather than downloaded, to stop a disguised huge file
# from exhausting memory/disk.
MAX_ATTACHMENT_BYTES=26214400

# Maximum total size (in bytes) of one backup zip. The run stops (and the
# partial zip is discarded) if this is exceeded, to protect the host's disk.
MAX_TOTAL_BACKUP_BYTES=524288000

# If "true", the bot automatically leaves any server that has granted it
# permissions beyond what a read-only photo backup needs (Administrator,
# Manage Server, Manage Roles, Kick/Ban Members, etc). Default is to just
# warn in the logs and refuse to run /backup there, without leaving.
AUTO_LEAVE_ON_EXCESS_PERMISSIONS=false
