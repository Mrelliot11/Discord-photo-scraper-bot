# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same Developer Portal page
DISCORD_CLIENT_ID=

# Optional: guild (server) ID to register slash commands to instantly for
# development. Leave blank to register commands globally (takes up to 1 hour
# to propagate).
DISCORD_GUILD_ID=

# Maximum number of messages to scan per channel when building the user list
# (safety cap to avoid runaway scans on huge channels).
MAX_MESSAGES_TO_SCAN=10000

# Maximum zip size (in bytes) the bot will attempt to upload back to Discord.
# Files larger than this are still saved locally but not attached to the reply.
MAX_DISCORD_UPLOAD_BYTES=8388608
